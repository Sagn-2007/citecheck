# ==========================================
# CiteCheck Environment Configuration Template
# ==========================================
# Copy this file to `.env` in the root or backend directory.
# NEVER commit your actual `.env` file to version control.

# ------------------------------------------
# Required Configuration
# ------------------------------------------
# A Google Gemini API key is required for extracting structured references
# from messy, unstructured bibliography text.
GEMINI_API_KEY=

# ------------------------------------------
# Optional Backend Configuration
# ------------------------------------------
# The specific Gemini model to use for extraction.
GEMINI_MODEL=gemini-3.8-flash

# SQLite database file path for caching API responses.
CITECHECK_CACHE_DB=citecheck_cache.db

# Maximum upload size for PDF/DOCX parsing in megabytes.
CITECHECK_MAX_UPLOAD_MB=10

# ------------------------------------------
# Optional Scholarly Provider Configuration
# ------------------------------------------
# Crossref and OpenAlex strongly recommend providing a 'mailto' email address
# so your requests are routed to the 'polite pool', reducing rate limits.
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# Semantic Scholar uses an API key to lift their strict rate limit.
# If omitted, Semantic Scholar will still be tried, but may return 429 Too Many Requests.
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------
# Optional: URL pointing to the FastAPI backend. 
# If omitted, defaults to http://localhost:8000
VITE_API_BASE_URL=
